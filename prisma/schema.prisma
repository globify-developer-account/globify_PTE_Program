// =============================================================================
// GLOBIFY PTE PREMIUM — Database schema
// Globify Consultants · PostgreSQL + Prisma
//
// Money is stored as integer minor units (paisa / cents) in `*Cents` columns so
// no Decimal ever has to cross the server/client boundary. Format with
// `formatMoney()` from `src/lib/money.ts`.
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
// Enums
// -----------------------------------------------------------------------------

enum Role {
  STUDENT
  TEACHER
  CONTENT_MANAGER
  ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum PteSection {
  SPEAKING
  WRITING
  READING
  LISTENING
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  EXPIRED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PROCESSING
  MANUAL_REVIEW
  PAID
  FAILED
  REFUNDED
  CANCELLED
}

enum PaymentMethodKind {
  CARD
  BANK_TRANSFER
  EASYPAISA
  JAZZCASH
  STRIPE
  DEMO
}

enum SessionKind {
  PRACTICE
  MOCK
}

enum SessionStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

enum AttemptStatus {
  STARTED
  SUBMITTED
  SCORING
  SCORED
  FAILED
  SKIPPED
}

enum ScoreSource {
  RULE
  AI
  TEACHER
}

enum AiFeature {
  SPEAKING_SCORE
  WRITING_SCORE
  TRANSCRIPTION
  FEEDBACK
  RECOMMENDATION
  PROGRESS_ANALYSIS
  WRITING_IMPROVEMENT
  CONVERSATION
  CONVERSATION_REPORT
  SPEECH_SYNTHESIS
  IELTS_WRITING_SCORE
  IELTS_SPEAKING_SCORE
}

/// The shapes a writing improvement exercise can take. The first three mirror
/// the scored PTE tasks; FREEFORM is text the student brought themselves and
/// carries no word limit.
enum WritingTaskKind {
  ESSAY
  SUMMARIZE_WRITTEN_TEXT
  SUMMARIZE_SPOKEN_TEXT
  FREEFORM
}

enum AiRequestStatus {
  SUCCESS
  FAILED
  CACHED
  BLOCKED
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum RecommendationStatus {
  ACTIVE
  COMPLETED
  DISMISSED
}

enum ReviewStatus {
  REQUESTED
  IN_PROGRESS
  COMPLETED
  REJECTED
}

enum NotificationChannel {
  IN_APP
  EMAIL
  WHATSAPP
  SMS
}

enum ReferralStatus {
  CLICKED
  REGISTERED
  PURCHASED
  REWARDED
}

enum Audience {
  ALL
  FREE
  PREMIUM
  EXPIRED
}

enum MockTestKind {
  FULL
  SECTIONAL
}

/// The exam a piece of content belongs to. Everything that existed before this
/// enum was introduced is PTE, which is why every column defaults to it.
enum Exam {
  PTE
  IELTS
}

/// IELTS ships as two exams wearing one name. They share Listening but differ
/// in Reading (different passages *and* a stricter raw-score conversion) and in
/// Writing Task 1. Null means "applies to both", which is how Listening and
/// every PTE row is stored.
enum IeltsVariant {
  ACADEMIC
  GENERAL_TRAINING
}

/// Pearson sells two PTE products off one task bank. Academic (and its UKVI
/// sibling, which differs only in the secure-test-centre wrapper) is the
/// university/visa route; Core is the IRCC route and swaps Describe Image,
/// Retell Lecture and Write Essay for Write Email and Respond to a Situation.
/// A QuestionType lists the variants that offer it; a learner picks one on
/// their profile and the practice menus filter to it.
enum PteVariant {
  ACADEMIC_UKVI
  CORE
}

/// Which scale a Score is reported on. `Score.overall` stays the normalised
/// 0-90 currency the charts and progress rollups read; `Score.band` is
/// authoritative for IELTS and `overall` is derived from it.
enum ScoreScale {
  PTE_10_90
  IELTS_BAND
}

// -----------------------------------------------------------------------------
// Identity & access
// -----------------------------------------------------------------------------

model User {
  id            String     @id @default(cuid())
  email         String     @unique
  emailVerified DateTime?
  passwordHash  String?
  name          String
  role          Role       @default(STUDENT)
  status        UserStatus @default(ACTIVE)
  lastLoginAt   DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  profile          Profile?
  adminProfile     AdminUser?
  sessions         Session[]
  oauthAccounts    OAuthAccount[]
  resetTokens      PasswordResetToken[]
  subscriptions    Subscription[]
  payments         Payment[]
  practiceSessions PracticeSession[]
  attempts         Attempt[]
  progress         Progress[]
  snapshots        ProgressSnapshot[]
  recommendations  Recommendation[]
  notifications    Notification[]
  aiUsage          AiUsageLog[]
  usageCounters    UsageCounter[]
  couponUses       CouponRedemption[]
  auditLogs        AuditLog[]           @relation("AuditActor")
  authoredQuestions Question[]          @relation("QuestionAuthor")
  teacherReviews   TeacherReview[]      @relation("ReviewTeacher")
  referralsMade    Referral[]           @relation("Referrer")
  referralReceived Referral?            @relation("ReferredUser")
  reviewedPayments Payment[]            @relation("PaymentReviewer")
  studentNotes     StudentNote[]        @relation("NoteStudent")
  authoredNotes    StudentNote[]        @relation("NoteAuthor")
  enrollments      CourseEnrollment[]
  lessonProgress   LessonProgress[]
  authoredDrills   Drill[]              @relation("DrillAuthor")
  drillAttempts    DrillAttempt[]
  drillProgress    DrillProgress[]
  writingImprovements WritingImprovement[]
  conversations    Conversation[]
  vocabProgress    VocabWordProgress[]
  savedVocab       SavedVocabWord[]
  classBookings    ClassBooking[]
  circlePosts      CirclePost[]         @relation("CirclePostAuthor")
  circleComments   CircleComment[]      @relation("CircleCommentAuthor")
  circleReactions  CircleReaction[]
  instituteMemberships InstituteMember[]

  @@index([role, status])
  @@index([createdAt])
}

model Profile {
  id                   String    @id @default(cuid())
  userId               String    @unique
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  phone                String?
  country              String?   @default("Pakistan")
  city                 String?
  studyDestination     String?
  targetExam           Exam      @default(PTE)
  /// PTE target on the 10-90 scale. Ignored when targetExam is IELTS.
  targetScore          Int       @default(79)
  /// IELTS target band, 0-9 in half steps. Ignored when targetExam is PTE.
  targetBand           Float?
  /// Which IELTS exam the student is sitting. Null until they pick one.
  ieltsVariant         IeltsVariant?
  /// Which PTE product the student is sitting. Drives the task list they see.
  pteVariant           PteVariant @default(ACADEMIC_UKVI)
  currentEstimateScore Int?
  preferredTestDate    DateTime?
  dailyGoalMinutes     Int       @default(45)
  streakDays           Int       @default(0)
  longestStreak        Int       @default(0)
  lastPracticeDate     DateTime?
  avatarUrl            String?
  referralCode         String    @unique
  timezone             String    @default("Asia/Karachi")
  onboardedAt          DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([referralCode])
}

/// Admin-scoped extension of a User. Admins authenticate through the same
/// identity table — this holds only the extra fields and granular permissions.
model AdminUser {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String?
  permissions String[] @default([])
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Session {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String   @unique
  userAgent  String?
  ip         String?
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model OAuthAccount {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider          String
  providerAccountId String
  createdAt         DateTime @default(now())

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// -----------------------------------------------------------------------------
// Subscriptions, payments, coupons, referrals
// -----------------------------------------------------------------------------

model SubscriptionPlan {
  id           String   @id @default(cuid())
  code         String   @unique
  name         String
  tagline      String?
  description  String?
  priceCents   Int
  compareAtCents Int?
  currency     String   @default("PKR")
  durationDays Int
  features     String[] @default([])
  /// { aiSpeakingPerMonth, aiWritingPerMonth, mockTestsPerMonth, practicePerDay, teacherReviews } — -1 means unlimited
  limits       Json     @default("{}")
  isActive     Boolean  @default(true)
  isPopular    Boolean  @default(false)
  badge        String?
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  subscriptions Subscription[]
  payments      Payment[]

  @@index([isActive, displayOrder])
}

model Subscription {
  id        String             @id @default(cuid())
  userId    String
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId    String
  plan      SubscriptionPlan   @relation(fields: [planId], references: [id])
  status    SubscriptionStatus @default(PENDING)
  startedAt DateTime?
  expiresAt DateTime?
  cancelledAt DateTime?
  autoRenew Boolean            @default(false)
  source    String             @default("checkout")
  note      String?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  payments Payment[]

  @@index([userId, status])
  @@index([expiresAt])
  @@index([createdAt])
}

model Payment {
  id             String            @id @default(cuid())
  reference      String            @unique
  userId         String
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId         String
  plan           SubscriptionPlan  @relation(fields: [planId], references: [id])
  subscriptionId String?
  subscription   Subscription?     @relation(fields: [subscriptionId], references: [id])
  couponId       String?
  coupon         Coupon?           @relation(fields: [couponId], references: [id])

  provider       String
  method         PaymentMethodKind
  providerRef    String?
  status         PaymentStatus     @default(PENDING)

  subtotalCents  Int
  discountCents  Int               @default(0)
  taxCents       Int               @default(0)
  totalCents     Int
  currency       String            @default("PKR")

  customerName   String?
  customerEmail  String?
  customerPhone  String?

  proofUrl       String?
  failureReason  String?
  reviewNote     String?
  reviewedById   String?
  reviewedBy     User?             @relation("PaymentReviewer", fields: [reviewedById], references: [id])
  reviewedAt     DateTime?
  paidAt         DateTime?
  metadata       Json              @default("{}")
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  referral Referral?

  @@index([userId])
  @@index([subscriptionId])
  @@index([status, createdAt])
  @@index([createdAt])
}

/// Raw provider webhook deliveries. `eventId` is unique so a redelivered event
/// can never activate a subscription twice.
model WebhookEvent {
  id          String   @id @default(cuid())
  provider    String
  eventId     String
  eventType   String
  payload     Json
  processedAt DateTime?
  error       String?
  createdAt   DateTime @default(now())

  @@unique([provider, eventId])
  @@index([createdAt])
}

model Coupon {
  id             String       @id @default(cuid())
  code           String       @unique
  description    String?
  discountType   DiscountType
  /// Percent (1-100) when PERCENTAGE, minor units when FIXED.
  discountValue  Int
  maxDiscountCents Int?
  minSubtotalCents Int        @default(0)
  applicablePlanIds String[]  @default([])
  usageLimit     Int?
  perUserLimit   Int          @default(1)
  usedCount      Int          @default(0)
  startsAt       DateTime?
  expiresAt      DateTime?
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  payments    Payment[]
  redemptions CouponRedemption[]

  @@index([isActive, expiresAt])
}

model CouponRedemption {
  id        String   @id @default(cuid())
  couponId  String
  coupon    Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  paymentId String?
  createdAt DateTime @default(now())

  @@index([couponId, userId])
}

model Referral {
  id             String         @id @default(cuid())
  code           String
  referrerId     String
  referrer       User           @relation("Referrer", fields: [referrerId], references: [id], onDelete: Cascade)
  referredUserId String?        @unique
  referredUser   User?          @relation("ReferredUser", fields: [referredUserId], references: [id], onDelete: SetNull)
  paymentId      String?        @unique
  payment        Payment?       @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  status         ReferralStatus @default(CLICKED)
  rewardCents    Int            @default(0)
  rewardedAt     DateTime?
  landingPath    String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([referrerId, status])
  @@index([code])
}

// -----------------------------------------------------------------------------
// Question bank
// -----------------------------------------------------------------------------

/// Question types are rows, not an enum — new PTE task types can be added from
/// the admin panel without a migration. `code` is the stable contract the
/// renderers key off (see src/lib/pte/question-types.ts).
model QuestionType {
  id             String     @id @default(cuid())
  code           String     @unique
  name           String
  shortName      String
  exam           Exam       @default(PTE)
  section        PteSection
  description    String?
  /// Renderer key — maps to a React component in the practice engine.
  renderer       String
  /// Contributes to these skill dimensions (used by the recommendation engine).
  skills         String[]   @default([])
  defaultTimeLimitSeconds Int?
  defaultPreparationSeconds Int?
  requiresAudioResponse  Boolean @default(false)
  requiresTextResponse   Boolean @default(false)
  /// Estimated share of the total score, as a percentage. Displayed in the
  /// practice menu so students can prioritise. Below 1% is stored as 0.5.
  scoreWeight    Float      @default(0)
  /// PTE products offering this task. Empty for IELTS rows.
  variants       PteVariant[] @default([])
  /// Recently introduced by Pearson — drives the "New" badge.
  isNew          Boolean    @default(false)
  isActive       Boolean    @default(true)
  displayOrder   Int        @default(0)
  /// High-water mark for `Question.typeNumber`. Incremented in the same
  /// transaction that creates a question so numbers never collide or reuse.
  lastTypeNumber Int        @default(0)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  questions Question[]

  @@index([exam, section, displayOrder])
}

model QuestionCategory {
  id           String   @id @default(cuid())
  slug         String   @unique
  name         String
  description  String?
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())

  questions Question[]
}

model Question {
  id             String        @id @default(cuid())
  code           String        @unique
  questionTypeId String
  questionType   QuestionType  @relation(fields: [questionTypeId], references: [id])
  categoryId     String?
  category       QuestionCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  /// Sequential number within the question type, so students can refer to a
  /// task the way they do in study groups: "RA #677". Assigned on publish from
  /// `QuestionType.lastTypeNumber`; null while the question is still a draft.
  typeNumber     Int?

  title          String
  /// Prompt / instruction shown above the task.
  prompt         String?
  /// Reading passage or the text to be read aloud.
  passage        String?
  imageUrl       String?
  audioUrl       String?
  /// Transcript of audioUrl — used for AI scoring and accessibility.
  audioTranscript String?
  /// Academic vs General Training, for the IELTS tasks whose content differs.
  /// Null for PTE and for IELTS content shared by both variants.
  variant        IeltsVariant?
  /// Shape depends on the renderer (see src/lib/pte/schemas.ts).
  options        Json          @default("[]")
  correctAnswer  Json          @default("{}")
  explanation    String?
  sampleAnswer   String?

  difficulty     Difficulty    @default(MEDIUM)
  status         ContentStatus @default(DRAFT)
  tags           String[]      @default([])
  timeLimitSeconds     Int?
  preparationSeconds   Int?
  wordLimitMin   Int?
  wordLimitMax   Int?
  isPremium      Boolean       @default(false)

  timesAttempted Int           @default(0)
  averageScore   Float?

  createdById    String?
  createdBy      User?         @relation("QuestionAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  attempts   Attempt[]
  setItems   QuestionSetItem[]
  mockItems  MockTestQuestion[]
  lessonItems LessonQuestion[]

  @@unique([questionTypeId, typeNumber])
  @@index([questionTypeId, status])
  @@index([status, difficulty])
  @@index([createdAt])
}

model QuestionSet {
  id           String        @id @default(cuid())
  slug         String        @unique
  name         String
  description  String?
  exam         Exam          @default(PTE)
  section      PteSection?
  isPremium    Boolean       @default(false)
  status       ContentStatus @default(PUBLISHED)
  displayOrder Int           @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  items            QuestionSetItem[]
  practiceSessions PracticeSession[]
}

model QuestionSetItem {
  id            String      @id @default(cuid())
  questionSetId String
  questionSet   QuestionSet @relation(fields: [questionSetId], references: [id], onDelete: Cascade)
  questionId    String
  question      Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)
  order         Int         @default(0)

  @@unique([questionSetId, questionId])
  @@index([questionId])
}

// -----------------------------------------------------------------------------
// Mock tests
// -----------------------------------------------------------------------------

model MockTest {
  id              String        @id @default(cuid())
  slug            String        @unique
  title           String
  description     String?
  exam            Exam          @default(PTE)
  variant         IeltsVariant?
  kind            MockTestKind  @default(FULL)
  difficulty      Difficulty    @default(MEDIUM)
  durationMinutes Int           @default(120)
  isPremium       Boolean       @default(true)
  status          ContentStatus @default(DRAFT)
  displayOrder    Int           @default(0)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  sections MockTestSection[]
  sessions PracticeSession[]
  results  MockTestResult[]

  @@index([status, displayOrder])
}

model MockTestSection {
  id              String     @id @default(cuid())
  mockTestId      String
  mockTest        MockTest   @relation(fields: [mockTestId], references: [id], onDelete: Cascade)
  section         PteSection
  title           String
  instructions    String?
  order           Int        @default(0)
  durationSeconds Int
  /// Relative contribution of this section to the overall estimated score.
  weight          Float      @default(1)

  questions MockTestQuestion[]

  @@unique([mockTestId, order])
}

model MockTestQuestion {
  id         String          @id @default(cuid())
  sectionId  String
  section    MockTestSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  questionId String
  question   Question        @relation(fields: [questionId], references: [id], onDelete: Cascade)
  order      Int             @default(0)

  @@unique([sectionId, questionId])
  @@index([questionId])
}

model MockTestResult {
  id             String   @id @default(cuid())
  sessionId      String   @unique
  session        PracticeSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  mockTestId     String
  mockTest       MockTest @relation(fields: [mockTestId], references: [id], onDelete: Cascade)
  userId         String
  overallScore   Int
  speakingScore  Int
  writingScore   Int
  readingScore   Int
  listeningScore Int
  /// IELTS band equivalents. Null on PTE results.
  overallBand    Float?
  speakingBand   Float?
  writingBand    Float?
  readingBand    Float?
  listeningBand  Float?
  /// { grammar, oralFluency, pronunciation, spelling, vocabulary, writtenDiscourse }
  enablingSkills Json     @default("{}")
  strongestArea  String?
  weakestArea    String?
  createdAt      DateTime @default(now())

  @@index([userId, createdAt])
  @@index([mockTestId])
}

// -----------------------------------------------------------------------------
// Practice, attempts, scoring
// -----------------------------------------------------------------------------

model PracticeSession {
  id            String        @id @default(cuid())
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind          SessionKind   @default(PRACTICE)
  status        SessionStatus @default(IN_PROGRESS)
  section       PteSection?
  questionTypeCode String?
  questionSetId String?
  questionSet   QuestionSet?  @relation(fields: [questionSetId], references: [id], onDelete: SetNull)
  mockTestId    String?
  mockTest      MockTest?     @relation(fields: [mockTestId], references: [id], onDelete: SetNull)

  totalQuestions     Int      @default(0)
  completedQuestions Int      @default(0)
  durationSeconds    Int      @default(0)
  startedAt          DateTime @default(now())
  completedAt        DateTime?
  updatedAt          DateTime @updatedAt

  attempts Attempt[]
  result   MockTestResult?

  @@index([userId, status])
  @@index([userId, startedAt])
  @@index([mockTestId])
}

model Attempt {
  id         String          @id @default(cuid())
  userId     String
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionId String
  question   Question        @relation(fields: [questionId], references: [id], onDelete: Cascade)
  sessionId  String?
  session    PracticeSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  status           AttemptStatus @default(STARTED)
  timeSpentSeconds Int           @default(0)
  startedAt        DateTime      @default(now())
  submittedAt      DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  answer     Answer?
  score      Score?
  aiAnalysis AIAnalysis?
  review     TeacherReview?

  @@index([userId, createdAt])
  @@index([questionId])
  @@index([sessionId])
  @@index([status])
}

model Answer {
  id        String   @id @default(cuid())
  attemptId String   @unique
  attempt   Attempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  text            String?
  /// Selected option ids, ordered item ids or per-blank values — shape per renderer.
  selection       Json    @default("{}")
  audioUrl        String?
  audioDurationMs Int?
  transcript      String?
  wordCount       Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Score {
  id          String      @id @default(cuid())
  attemptId   String      @unique
  attempt     Attempt     @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  source      ScoreSource @default(RULE)
  /// Normalised 0-90 estimate. Kept for every exam so progress rollups, charts
  /// and the recommendation engine have one comparable number to read.
  overall     Int
  /// Which scale this score was actually produced on.
  scale       ScoreScale  @default(PTE_10_90)
  /// IELTS band, 0-9 in half steps. Authoritative when scale is IELTS_BAND;
  /// `overall` is derived from it. Null for PTE.
  band        Float?
  rawScore    Float?
  maxRawScore Float?
  isCorrect   Boolean?
  /// { content, pronunciation, fluency, grammar, vocabulary, form, coherence, development, spelling }
  breakdown   Json        @default("{}")
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([createdAt])
}

model AIAnalysis {
  id          String   @id @default(cuid())
  attemptId   String   @unique
  attempt     Attempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  provider    String
  model       String
  feature     AiFeature
  /// Validated, schema-checked payload. Raw provider text never reaches the UI.
  result      Json
  strengths   String[] @default([])
  improvements String[] @default([])
  suggestions String[] @default([])
  suggestedRewrite String?
  promptTokens     Int?
  completionTokens Int?
  costMicros       Int?
  latencyMs        Int?
  createdAt   DateTime @default(now())

  @@index([createdAt])
}

model TeacherReview {
  id           String       @id @default(cuid())
  attemptId    String       @unique
  attempt      Attempt      @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  studentId    String
  teacherId    String?
  teacher      User?        @relation("ReviewTeacher", fields: [teacherId], references: [id], onDelete: SetNull)
  status       ReviewStatus @default(REQUESTED)
  score        Int?
  comments     String?
  corrections  String?
  recommendations String?
  requestedAt  DateTime     @default(now())
  reviewedAt   DateTime?

  @@index([status, requestedAt])
  @@index([studentId])
}

// -----------------------------------------------------------------------------
// Progress & recommendations
// -----------------------------------------------------------------------------

model Progress {
  id              String     @id @default(cuid())
  userId          String
  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  exam            Exam       @default(PTE)
  section         PteSection
  estimatedScore  Int        @default(0)
  previousScore   Int?
  accuracy        Float      @default(0)
  attemptsCount   Int        @default(0)
  minutesPracticed Int       @default(0)
  /// Per question-type rollup: { [typeCode]: { attempts, avg } }
  byQuestionType  Json       @default("{}")
  updatedAt       DateTime   @updatedAt

  @@unique([userId, exam, section])
  @@index([userId])
}

/// One row per student per day. Per-section scores are columns rather than
/// separate rows so the whole chart reads from a single query, and so the
/// unique key needs no nullable column (Postgres treats NULLs as distinct,
/// which would silently defeat a unique constraint containing one).
model ProgressSnapshot {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  exam           Exam     @default(PTE)
  date           DateTime @db.Date
  overallScore   Int      @default(0)
  speakingScore  Int?
  writingScore   Int?
  readingScore   Int?
  listeningScore Int?
  attempts       Int      @default(0)
  minutes        Int      @default(0)

  @@unique([userId, exam, date])
  @@index([userId, exam, date])
}

model Recommendation {
  id               String               @id @default(cuid())
  userId           String
  user             User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  code             String
  title            String
  body             String
  section          PteSection?
  questionTypeCode String?
  actionLabel      String?
  actionHref       String?
  priority         Int                  @default(0)
  status           RecommendationStatus @default(ACTIVE)
  source           ScoreSource          @default(RULE)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@unique([userId, code])
  @@index([userId, status, priority])
}

// -----------------------------------------------------------------------------
// Content, comms & operations
// -----------------------------------------------------------------------------

model Announcement {
  id          String        @id @default(cuid())
  title       String
  body        String
  audience    Audience      @default(ALL)
  status      ContentStatus @default(DRAFT)
  isPinned    Boolean       @default(false)
  publishedAt DateTime?
  expiresAt   DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status, publishedAt])
}

model Resource {
  id           String        @id @default(cuid())
  slug         String        @unique
  title        String
  excerpt      String?
  category     String
  tags         String[]      @default([])
  contentMd    String
  readMinutes  Int           @default(4)
  isPremium    Boolean       @default(false)
  status       ContentStatus @default(DRAFT)
  displayOrder Int           @default(0)
  publishedAt  DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([status, category])
}

model Notification {
  id        String              @id @default(cuid())
  userId    String
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel   NotificationChannel @default(IN_APP)
  type      String
  title     String
  body      String
  href      String?
  readAt    DateTime?
  sentAt    DateTime?
  createdAt DateTime            @default(now())

  @@index([userId, readAt])
  @@index([createdAt])
}

model StudentNote {
  id        String   @id @default(cuid())
  studentId String
  student   User     @relation("NoteStudent", fields: [studentId], references: [id], onDelete: Cascade)
  authorId  String?
  author    User?    @relation("NoteAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  body      String
  createdAt DateTime @default(now())

  @@index([studentId, createdAt])
}

/// Messages from the public contact form and in-app support widget.
model SupportMessage {
  id          String    @id @default(cuid())
  name        String
  email       String
  phone       String?
  topic       String    @default("general")
  targetScore Int?
  message     String
  userId      String?
  status      String    @default("NEW")
  handledById String?
  handledAt   DateTime?
  ip          String?
  createdAt   DateTime  @default(now())

  @@index([status, createdAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actor     User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  actorRole Role?
  action    String
  entity    String
  entityId  String?
  metadata  Json     @default("{}")
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([actorId])
  @@index([createdAt])
}

// -----------------------------------------------------------------------------
// AI cost control
// -----------------------------------------------------------------------------

model AiUsageLog {
  id               String          @id @default(cuid())
  userId           String?
  user             User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  feature          AiFeature
  provider         String
  model            String
  status           AiRequestStatus @default(SUCCESS)
  promptTokens     Int             @default(0)
  completionTokens Int             @default(0)
  /// Estimated cost in millionths of a USD — integers keep aggregation exact.
  costMicros       Int             @default(0)
  latencyMs        Int             @default(0)
  error            String?
  createdAt        DateTime        @default(now())

  @@index([userId, createdAt])
  @@index([feature, createdAt])
  @@index([createdAt])
}

/// Per-user, per-feature counters scoped to a billing/rolling window. Used to
/// enforce free-tier and plan-defined limits without scanning attempt history.
model UsageCounter {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  feature     String
  periodStart DateTime
  periodEnd   DateTime
  count       Int      @default(0)
  updatedAt   DateTime @updatedAt

  @@unique([userId, feature, periodStart])
  @@index([userId, feature])
}

model PlatformSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

// -----------------------------------------------------------------------------
// Courses
//
// A course is an ordered path through the material: Course -> CourseModule ->
// Lesson. Modules are optional — a short course can hang lessons straight off
// the course and leave `moduleId` null, which is why lessons carry their own
// `order` rather than relying on the module for sequencing.
//
// Lessons reuse the existing question bank through LessonQuestion instead of
// duplicating content, so a drill inside a lesson is the same Question row the
// practice engine already renders and scores.
// -----------------------------------------------------------------------------

enum LessonKind {
  ARTICLE
  VIDEO
  VOCABULARY
  FLASHCARD
  DICTATION
  SHADOWING
  PRONUNCIATION
  QUIZ
}

enum LessonState {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

model Course {
  id           String        @id @default(cuid())
  slug         String        @unique
  title        String
  subtitle     String?
  description  String?
  /// Null for courses that span every section (vocabulary, study skills).
  section      PteSection?
  level        Difficulty    @default(MEDIUM)
  coverImageUrl String?
  isPremium    Boolean       @default(false)
  status       ContentStatus @default(DRAFT)
  tags         String[]      @default([])
  /// Denormalised for listing cards, recomputed when lessons change.
  lessonCount      Int       @default(0)
  estimatedMinutes Int       @default(0)
  displayOrder Int           @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  modules     CourseModule[]
  lessons     Lesson[]
  enrollments CourseEnrollment[]

  @@index([status, displayOrder])
  @@index([section, status])
}

model CourseModule {
  id          String   @id @default(cuid())
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title       String
  description String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  lessons Lesson[]

  @@index([courseId, order])
}

model Lesson {
  id       String        @id @default(cuid())
  courseId String
  course   Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  moduleId String?
  module   CourseModule? @relation(fields: [moduleId], references: [id], onDelete: SetNull)

  slug     String
  /// Learner-facing sequence number ("Lesson 7"), distinct from `order`, which
  /// is the sort key and may be rewritten when lessons are reordered.
  number   Int
  title    String
  summary  String?
  kind     LessonKind    @default(ARTICLE)
  /// Body content — shape depends on `kind` (see src/lib/pte/schemas.ts).
  content  Json          @default("{}")
  videoUrl String?
  audioUrl String?
  audioTranscript String?

  estimatedMinutes Int          @default(5)
  isPremium        Boolean      @default(false)
  status           ContentStatus @default(DRAFT)
  order            Int          @default(0)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  questions LessonQuestion[]
  progress  LessonProgress[]

  @@unique([courseId, slug])
  @@index([courseId, order])
  @@index([moduleId, order])
  @@index([status])
}

/// Attaches an existing bank question to a lesson as an inline drill.
model LessonQuestion {
  id         String   @id @default(cuid())
  lessonId   String
  lesson     Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  order      Int      @default(0)

  @@unique([lessonId, questionId])
  @@index([questionId])
}

model CourseEnrollment {
  id       String   @id @default(cuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId String
  course   Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  /// Cached 0-100 rollup of LessonProgress, so course cards need one query.
  percentComplete Int      @default(0)
  lessonsDone     Int      @default(0)
  startedAt       DateTime @default(now())
  lastActivityAt  DateTime @default(now())
  completedAt     DateTime?

  @@unique([userId, courseId])
  @@index([userId, lastActivityAt])
}

model LessonProgress {
  id       String      @id @default(cuid())
  userId   String
  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId String
  lesson   Lesson      @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  state        LessonState @default(NOT_STARTED)
  secondsSpent Int         @default(0)
  lastViewedAt DateTime    @default(now())
  completedAt  DateTime?

  @@unique([userId, lessonId])
  @@index([userId, state])
  @@index([lessonId])
}

// -----------------------------------------------------------------------------
// Writing improvement
// -----------------------------------------------------------------------------

/// A prompt in the writing improvement library. Deliberately separate from
/// `Question`: these are never scored inside a session, never appear in a mock
/// test, and exist only as starting points for the improvement tool.
model WritingExercise {
  id           String          @id @default(cuid())
  slug         String          @unique
  title        String
  /// Free-text grouping shown as a filter chip, e.g. "Argument" or "Education".
  category     String
  taskKind     WritingTaskKind @default(ESSAY)
  prompt       String
  /// Source text for the summarise tasks.
  passage      String?
  /// One or two sentences of coaching shown beside the editor.
  guidance     String?
  tags         String[]        @default([])
  difficulty   Difficulty      @default(MEDIUM)
  wordMin      Int             @default(200)
  wordMax      Int             @default(300)
  minutes      Int             @default(20)
  isPremium    Boolean         @default(false)
  status       ContentStatus   @default(PUBLISHED)
  displayOrder Int             @default(0)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  improvements WritingImprovement[]

  @@index([status, category])
  @@index([status, taskKind])
}

/// One run of the improvement tool. Kept so a student can reopen what they
/// wrote and so the library can show which exercises they have worked on.
model WritingImprovement {
  id         String           @id @default(cuid())
  userId     String
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  exerciseId String?
  exercise   WritingExercise? @relation(fields: [exerciseId], references: [id], onDelete: SetNull)

  taskKind     WritingTaskKind @default(FREEFORM)
  prompt       String?
  originalText String
  improvedText String
  summary      String
  /// `{ original, replacement, category, explanation }[]` — see `writingImprovementSchema`.
  edits        Json            @default("[]")
  editCount    Int             @default(0)
  wordCount    Int             @default(0)
  /// Which AI provider produced this, so a simulated run stays labelled.
  provider     String?
  createdAt    DateTime        @default(now())

  @@index([userId, createdAt])
  @@index([exerciseId])
}

// -----------------------------------------------------------------------------
// Dictation & shadowing drills
//
// A separate library from the PTE question bank. A drill is one short recording
// plus its transcript, split into sentence-length segments, and every drill can
// be worked through in two modes:
//
//   DICTATION  — listen to a segment and type it. The segment text is withheld
//                from the browser until the answer has been posted.
//   SHADOWING  — read the segment aloud with the recording. The text is shown,
//                because that is the exercise.
//
// Both modes end in the same word-by-word comparison (src/lib/drills/diff.ts),
// so one DrillAttempt shape covers both and progress is comparable across them.
// -----------------------------------------------------------------------------

enum DrillMode {
  DICTATION
  SHADOWING
}

model DrillCategory {
  id           String   @id @default(cuid())
  slug         String   @unique
  name         String
  description  String?
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  drills Drill[]

  @@index([displayOrder])
}

model Drill {
  id          String        @id @default(cuid())
  slug        String        @unique
  title       String
  description String?
  categoryId  String
  category    DrillCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  /// Storage key or absolute URL — resolved to a signed URL before it is sent.
  audioUrl        String
  /// The whole recording as text. Segments are the practised unit; this is what
  /// gets shown as a reading passage and what an admin edits.
  transcript      String
  audioDurationMs Int?
  /// Free-text accent label ("British", "American") shown on the card.
  accent          String?
  wordCount       Int           @default(0)
  difficulty      Difficulty    @default(MEDIUM)
  isPremium       Boolean       @default(false)
  status          ContentStatus @default(DRAFT)
  tags            String[]      @default([])
  displayOrder    Int           @default(0)
  timesAttempted  Int           @default(0)

  createdById String?
  createdBy   User?    @relation("DrillAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  segments DrillSegment[]
  attempts DrillAttempt[]
  progress DrillProgress[]

  @@index([status, displayOrder])
  @@index([categoryId, status])
}

/// One sentence of a drill — the unit a learner types or shadows in one go.
model DrillSegment {
  id      String @id @default(cuid())
  drillId String
  drill   Drill  @relation(fields: [drillId], references: [id], onDelete: Cascade)
  order   Int
  text    String
  /// Offsets into the drill audio, so a segment can be looped on its own.
  startMs Int    @default(0)
  endMs   Int    @default(0)

  attempts DrillAttempt[]

  @@unique([drillId, order])
  @@index([drillId])
}

model DrillAttempt {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  drillId   String
  drill     Drill         @relation(fields: [drillId], references: [id], onDelete: Cascade)
  segmentId String?
  segment   DrillSegment? @relation(fields: [segmentId], references: [id], onDelete: SetNull)
  mode      DrillMode

  /// What was typed (dictation) or what the recording was transcribed to
  /// (shadowing) — the same field, because both are scored the same way.
  responseText String?
  audioUrl     String?
  audioDurationMs Int?

  /// 0–100, derived from the word alignment. Not a PTE score, and never
  /// presented as one.
  accuracy     Int   @default(0)
  wordsCorrect Int   @default(0)
  wordsTotal   Int   @default(0)
  /// Words per minute, shadowing only — pace against the reference recording.
  wordsPerMinute Int?
  /// The token-by-token verdict, so the review panel can be redrawn from history.
  detail       Json  @default("[]")
  /// How many times the clip was replayed before answering.
  playCount        Int @default(0)
  timeSpentSeconds Int @default(0)

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([drillId, mode])
  @@index([segmentId])
}

/// Per-user rollup so a library card needs one query instead of one per drill.
model DrillProgress {
  id      String    @id @default(cuid())
  userId  String
  user    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  drillId String
  drill   Drill     @relation(fields: [drillId], references: [id], onDelete: Cascade)
  mode    DrillMode

  attempts          Int      @default(0)
  bestAccuracy      Int      @default(0)
  lastAccuracy      Int      @default(0)
  /// Distinct segments answered at least once — drives the "3 of 8" ring.
  segmentsCompleted Int      @default(0)
  completedAt       DateTime?
  lastActivityAt    DateTime @default(now())

  @@unique([userId, drillId, mode])
  @@index([userId, lastActivityAt])
  @@index([drillId])
}

// -----------------------------------------------------------------------------
// AI Conversations
//
// Freeform spoken and typed practice against an AI partner. A ConversationTopic
// is the reusable scenario staff author; a Conversation is one student's run of
// it, and owns a denormalised copy of the scenario so an edited or deleted
// topic never rewrites history the student has already been given feedback on.
//
// Corrections live on the student's own message rather than in the partner's
// reply: the partner never breaks character to correct, which is the whole
// point of a low-pressure speaking exercise.
// -----------------------------------------------------------------------------

enum ConversationCategory {
  DAILY_LIFE
  SOCIAL
  TRAVEL
  WORK_AND_STUDY
  EXAM_PREP
  CUSTOM
}

enum ConversationStatus {
  ACTIVE
  COMPLETED
  ABANDONED
}

enum ChatRole {
  USER
  ASSISTANT
}

model ConversationTopic {
  id          String               @id @default(cuid())
  slug        String               @unique
  title       String
  subtitle    String?
  description String?
  category    ConversationCategory @default(DAILY_LIFE)
  level       Difficulty           @default(MEDIUM)
  /// Emoji shown on the topic card. Kept as text so staff can paste any glyph.
  emoji       String?

  /// Who the AI plays, e.g. "Sara".
  personaName String
  /// Their relationship to the student, e.g. "a neighbour you have just met".
  personaRole String
  /// The situation both sides are in, handed to the model verbatim.
  scenario    String
  /// The partner's first turn. Stored rather than generated so the conversation
  /// opens instantly, with no AI call and no spend, before the student speaks.
  openingLine String

  /// What the student should manage to do. Shown as a checklist and scored in the report.
  goals          String[] @default([])
  /// Ready-made openers offered when a student stalls.
  starterPhrases String[] @default([])
  /// Vocabulary and structures the partner steers towards.
  targetLanguage String[] @default([])

  isPremium    Boolean       @default(false)
  status       ContentStatus @default(DRAFT)
  displayOrder Int           @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  conversations Conversation[]

  @@index([status, displayOrder])
  @@index([category, status])
}

model Conversation {
  id      String             @id @default(cuid())
  userId  String
  user    User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  topicId String?
  topic   ConversationTopic? @relation(fields: [topicId], references: [id], onDelete: SetNull)

  /// Denormalised from the topic at creation. A conversation must keep the
  /// scenario it was actually held under, even if staff later edit or retire it.
  title       String
  scenario    String
  personaName String
  personaRole String
  level       Difficulty @default(MEDIUM)
  goals       String[]   @default([])
  /// True when the student wrote their own scenario instead of picking a topic.
  isCustom    Boolean    @default(false)

  status       ConversationStatus @default(ACTIVE)
  messageCount Int                @default(0)
  /// The student's own turns — what the report and the usage counter care about.
  userTurns    Int                @default(0)
  /// How many of those turns were spoken rather than typed.
  spokenTurns  Int                @default(0)

  startedAt     DateTime  @default(now())
  lastMessageAt DateTime  @default(now())
  completedAt   DateTime?

  messages ConversationMessage[]
  report   ConversationReport?

  @@index([userId, lastMessageAt])
  @@index([userId, status])
  @@index([topicId])
}

model ConversationMessage {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  role ChatRole
  /// Position in the conversation. Messages are always read in sequence, and
  /// the unique index is what stops a double-submit inserting the same turn twice.
  index   Int
  content String

  /// Storage key for the student's recording, when the turn was spoken.
  audioKey    String?
  transcribed Boolean @default(false)

  /// A gentle rewrite of the student's turn, shown beside it. Null when the
  /// turn needed no correction — which is the common case by design.
  correction     String?
  correctionNote String?
  /// Two or three things the student could say next.
  suggestions    String[] @default([])

  createdAt DateTime @default(now())

  @@unique([conversationId, index])
  @@index([conversationId, createdAt])
}

model ConversationReport {
  id             String       @id @default(cuid())
  conversationId String       @unique
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  /// AI estimated speaking band for the conversation, 10-90. Practice only —
  /// never presented as, or written into, an official score.
  estimatedScore Int
  fluency        Int
  vocabulary     Int
  grammar        Int
  /// How well the student sustained the exchange: asking back, following up, repairing.
  interaction    Int

  summary      String
  strengths    String[] @default([])
  improvements String[] @default([])
  nextSteps    String[] @default([])
  /// `{ said, better, why }[]` — see `conversationReportSchema`.
  corrections  Json     @default("[]")
  goalsMet     String[] @default([])

  /// Which provider produced this, so a simulated run stays labelled.
  provider  String?
  simulated Boolean  @default(false)
  createdAt DateTime @default(now())
}

// -----------------------------------------------------------------------------
// Vocabulary books
// -----------------------------------------------------------------------------

/// A vocab book is studied in one of two directions: see the word and recall
/// the meaning, or hear the word and write it. The same book can be offered in
/// both, so this is a property of the study session rather than the book.
enum VocabMode {
  READING
  LISTENING
}

/// How well a learner knows one word. Progress is per user per word, so the
/// same word appearing in two books shares one familiarity state.
enum VocabFamiliarity {
  NEW
  LEARNING
  FAMILIAR
  MASTERED
}

model VocabBook {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  description String?
  /// Two or three characters printed on the book spine in the card grid.
  badge       String
  /// Spine colour as a hex value, so admins can add books without a deploy.
  color       String    @default("#2e5bff")
  /// Which study directions this book supports.
  modes       VocabMode[] @default([READING, LISTENING])
  /// Books sourced from a task type link back to it for "practise these" CTAs.
  questionTypeCode String?
  isPremium   Boolean   @default(false)
  status      ContentStatus @default(PUBLISHED)
  displayOrder Int      @default(0)
  /// Denormalised count of published words — the card shows it on every render.
  wordCount   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  words VocabWord[]

  @@index([status, displayOrder])
}

model VocabWord {
  id           String   @id @default(cuid())
  bookId       String
  book         VocabBook @relation(fields: [bookId], references: [id], onDelete: Cascade)
  headword     String
  /// IPA, shown under the headword in reading mode.
  phonetic     String?
  audioUrl     String?
  partOfSpeech String?
  definition   String
  example      String?
  /// Other forms a dictation answer should accept (plurals, US/UK spellings).
  acceptedForms String[] @default([])
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  progress VocabWordProgress[]

  @@unique([bookId, headword])
  @@index([bookId, displayOrder])
}

model VocabWordProgress {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  wordId      String
  word        VocabWord @relation(fields: [wordId], references: [id], onDelete: Cascade)
  familiarity VocabFamiliarity @default(NEW)
  /// Consecutive correct recalls — drives the spacing interval.
  streak      Int      @default(0)
  timesSeen   Int      @default(0)
  timesCorrect Int     @default(0)
  lastSeenAt  DateTime?
  /// When this word next falls due. Null means it has never been studied.
  dueAt       DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, wordId])
  @@index([userId, dueAt])
  @@index([userId, familiarity])
}

/// Words a learner flagged while practising, independent of any book. This is
/// the "My Vocab List" book — it has no VocabBook row because its contents
/// differ per user.
model SavedVocabWord {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  headword   String
  /// Where they met the word, so the list can link back to the task.
  questionId String?
  note       String?
  familiarity VocabFamiliarity @default(NEW)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, headword])
  @@index([userId, createdAt])
}

// -----------------------------------------------------------------------------
// Live classes
// -----------------------------------------------------------------------------

enum LiveClassKind {
  LIVE_CLASS
  LECTURE
  PRACTICE_SESSION
  WORKSHOP
}

enum BookingStatus {
  RESERVED
  ATTENDED
  MISSED
  CANCELLED
}

model LiveClass {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String?
  kind        LiveClassKind @default(LIVE_CLASS)
  section     PteSection?
  instructorName String
  instructorAvatarUrl String?
  /// Stored in UTC. The dashboard renders it in Profile.timezone.
  startsAt    DateTime
  endsAt      DateTime
  /// Meeting link, revealed only to learners holding a booking.
  joinUrl     String?
  recordingUrl String?
  /// Null means unlimited seats.
  capacity    Int?
  /// Free classes are open to every signed-in learner; otherwise entitlement
  /// is checked against the subscription before a booking is written.
  isPremium   Boolean  @default(true)
  status      ContentStatus @default(PUBLISHED)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  bookings ClassBooking[]

  @@index([status, startsAt])
  @@index([kind, startsAt])
}

model ClassBooking {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  classId   String
  liveClass LiveClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  status    BookingStatus @default(RESERVED)
  bookedAt  DateTime @default(now())
  attendedAt DateTime?

  @@unique([userId, classId])
  @@index([userId, bookedAt])
  @@index([classId, status])
}

// -----------------------------------------------------------------------------
// Circle — the student community
// -----------------------------------------------------------------------------

enum CirclePostCategory {
  EXAM_EXPERIENCE
  QUESTION_PREDICTION
  STUDY_TIP
  SCORE_REPORT
  GENERAL
}

enum CirclePostStatus {
  PUBLISHED
  HIDDEN
  REMOVED
}

model CirclePost {
  id        String   @id @default(cuid())
  authorId  String
  author    User     @relation("CirclePostAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  title     String
  body      String
  category  CirclePostCategory @default(GENERAL)
  section   PteSection?
  /// Score the poster reported, when they are sharing a result.
  reportedScore Int?
  /// When they sat the exam — how prediction threads stay sorted by recency.
  examDate  DateTime?
  tags      String[] @default([])
  status    CirclePostStatus @default(PUBLISHED)
  /// Denormalised so the feed does not aggregate on every read.
  likeCount    Int   @default(0)
  commentCount Int   @default(0)
  /// Staff-promoted posts pin to the top of the feed.
  isPinned  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  comments  CircleComment[]
  reactions CircleReaction[]

  @@index([status, isPinned, createdAt])
  @@index([category, createdAt])
  @@index([authorId, createdAt])
}

model CircleComment {
  id        String   @id @default(cuid())
  postId    String
  post      CirclePost @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation("CircleCommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  body      String
  /// Set for a reply to another comment; null for a top-level comment.
  parentId  String?
  parent    CircleComment? @relation("CircleCommentThread", fields: [parentId], references: [id], onDelete: Cascade)
  replies   CircleComment[] @relation("CircleCommentThread")
  status    CirclePostStatus @default(PUBLISHED)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([postId, createdAt])
  @@index([parentId])
}

model CircleReaction {
  id        String   @id @default(cuid())
  postId    String
  post      CirclePost @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([postId, userId])
  @@index([userId, createdAt])
}

// -----------------------------------------------------------------------------
// Institute mode — coaching centres managing their own cohorts
// -----------------------------------------------------------------------------

enum InstituteRole {
  OWNER
  TEACHER
  STUDENT
}

enum InstituteStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

model Institute {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  logoUrl   String?
  contactEmail String?
  contactPhone String?
  /// Seats the institute has paid for. Membership writes check this.
  seatLimit Int      @default(25)
  status    InstituteStatus @default(PENDING)
  /// Join code students enter to attach themselves to this institute.
  joinCode  String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members InstituteMember[]

  @@index([status, name])
}

model InstituteMember {
  id          String   @id @default(cuid())
  instituteId String
  institute   Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        InstituteRole @default(STUDENT)
  /// Free-text cohort label ("Feb Morning Batch") the institute sets.
  batch       String?
  joinedAt    DateTime @default(now())

  @@unique([instituteId, userId])
  @@index([instituteId, role])
  @@index([userId])
}
