# =============================================================================
# GLOBIFY PTE PREMIUM — environment configuration
# Copy to `.env` (local) or set these in your hosting provider.
# Never commit real values.
# =============================================================================

# --- Core -------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Postgres connection string.
# Local:  postgresql://postgres:postgres@localhost:5432/globify_pte
# Neon:   postgresql://USER:PASSWORD@HOST/DB?sslmode=require
DATABASE_URL=

# --- Authentication ---------------------------------------------------------
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=
AUTH_SESSION_DAYS=30

# Optional Google sign-in. Redirect URI: {NEXT_PUBLIC_APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Demo mode --------------------------------------------------------------
# true  -> payments auto-succeed, AI scoring is simulated. Default ON outside production.
# Must be explicitly set to true to run in production (not recommended).
DEMO_MODE=true

# --- AI ---------------------------------------------------------------------
# demo | openai | anthropic | gemini
AI_PROVIDER=demo
AI_API_KEY=
# Optional model override; each provider ships a sensible default.
AI_MODEL=
# Provider used when the primary one errors out (leave blank to disable fallback).
AI_FALLBACK_PROVIDER=
# Speech-to-text for Speaking tasks and AI Conversations: demo | openai
AI_TRANSCRIPTION_PROVIDER=demo
AI_TRANSCRIPTION_API_KEY=
# Model used for AI Conversations. Chat turns are latency-sensitive, so a
# smaller/faster model than AI_MODEL usually reads better here.
AI_CONVERSATION_MODEL=
# Text-to-speech for the conversation partner: openai | none.
# Left blank in demo mode, replies are read by the browser's own voice, which
# needs no credentials and works offline.
AI_SPEECH_PROVIDER=
AI_SPEECH_API_KEY=
AI_SPEECH_MODEL=
AI_SPEECH_VOICE=
# Hard monthly ceiling in USD across all AI features. 0 disables the ceiling.
AI_MONTHLY_BUDGET_USD=0
AI_MAX_RETRIES=2
AI_TIMEOUT_MS=45000

# --- Payments ---------------------------------------------------------------
# demo | manual | stripe | easypaisa | jazzcash
PAYMENT_PROVIDER=demo
PAYMENT_API_KEY=
PAYMENT_WEBHOOK_SECRET=
PAYMENT_CURRENCY=PKR
PAYMENT_TAX_PERCENT=0

# Shown to students who choose manual bank transfer.
BANK_ACCOUNT_TITLE=Globify Consultants
BANK_ACCOUNT_NUMBER=
BANK_IBAN=
BANK_NAME=
EASYPAISA_NUMBER=
JAZZCASH_NUMBER=

# --- Storage (recorded audio, payment proofs) --------------------------------
# local | s3   (s3 covers any S3-compatible service: AWS S3, Cloudflare R2, Backblaze B2)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=storage
STORAGE_BUCKET=
STORAGE_REGION=auto
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_PUBLIC_BASE_URL=
STORAGE_MAX_UPLOAD_MB=15

# --- Analytics (optional) ----------------------------------------------------
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# --- Platform switches -------------------------------------------------------
REGISTRATION_ENABLED=true
MAINTENANCE_MODE=false

# --- Seed (development only) -------------------------------------------------
SEED_ADMIN_EMAIL=admin@globifyconsultants.com
SEED_ADMIN_PASSWORD=
SEED_STUDENT_PASSWORD=
