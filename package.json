{
  "name": "globify-pte-premium",
  "version": "1.0.0",
  "private": true,
  "description": "Globify PTE Premium — AI-powered PTE preparation platform by Globify Consultants.",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "// build": "Must not touch the database. Build environments frequently have no DATABASE_URL and no network route to Postgres, and a build that needs one fails before Next.js compiles anything. Migrations run at start instead — see the start script.",
    "build": "prisma generate && next build",
    "// start": "Applies pending migrations, then serves. This runs in the runtime environment, where DATABASE_URL is guaranteed to exist. `migrate deploy` is idempotent, takes an advisory lock so concurrent instances are safe, and never resets data. Next reads PORT from the environment.",
    "start": "prisma migrate deploy && next start",
    "start:no-migrate": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force",
    "verify:storage": "tsx scripts/verify-storage.mts",
    "sync:question-types": "tsx scripts/sync-question-types.ts",
    "content:generate": "tsx scripts/generate-questions.ts",
    "accounts:create": "tsx scripts/create-accounts.ts",
    "migration:build": "tsx scripts/build-migration.ts"
  },
  "dependencies": {
    "@anthropic-ai/aws-sdk": "^0.7.1",
    "@anthropic-ai/sdk": "^0.116.0",
    "@prisma/client": "^6.3.1",
    "bcryptjs": "^3.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.4.7",
    "lucide-react": "^0.475.0",
    "next": "15.5.25",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.1",
    "tailwind-merge": "^3.0.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@tailwindcss/postcss": "^4.0.9",
    "@types/node": "^22.13.5",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "dotenv": "^16.4.7",
    "eslint": "^9.21.0",
    "eslint-config-next": "15.5.25",
    "prisma": "^6.3.1",
    "tailwindcss": "^4.0.9",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  },
  "allowScripts": {
    "prisma@6.19.3": true,
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true
  }
}
