# =============================================================================
# Globify PTE Premium — PRODUCTION environment
# =============================================================================
#
# Paste these into Hostinger hPanel → your Node.js app → Environment Variables.
# Do NOT commit a filled-in copy of this file. `.env.production` is gitignored;
# this `.example` is the template that is safe to keep in the repository.
#
# Every value marked TODO must be replaced before you take payments.
# -----------------------------------------------------------------------------

# --- Core --------------------------------------------------------------------

# The public origin, no trailing slash. Drives canonical URLs, the sitemap,
# checkout return URLs and the Google OAuth redirect. Must be https in production.
NEXT_PUBLIC_APP_URL=https://TODO-your-domain.com

NODE_ENV=production

# Demo mode MUST be false in production. The app refuses to start with it on
# (see assertRuntimeEnv in src/lib/env.ts) because it would simulate payments.
DEMO_MODE=false


# --- Database ----------------------------------------------------------------

# Neon connection string. Use the POOLED endpoint (it has "-pooler" in the host)
# — a serverless/managed runtime opens and drops connections constantly and will
# exhaust a direct endpoint.
#
# SECURITY: rotate this password in the Neon console before going live. The
# development password was shared in plain text and must be considered burned.
DATABASE_URL=postgresql://USER:TODO-ROTATED-PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require


# --- Authentication ----------------------------------------------------------

# Signs session tokens, password-reset tokens and storage URLs.
# Changing it invalidates every active session and every outstanding reset link.
# Generated fresh for this deployment — do not reuse the development value.
AUTH_SECRET=Oh0Qxqb1TaJfqUmUZqJVOYGbb9g92D3YWw9HM_whkXyhJ1Kf4zcS9LScR7i21Xjz

# How long a session stays valid.
AUTH_SESSION_DAYS=30

# Google sign-in (optional). Leave blank to hide the button entirely.
# Authorised redirect URI must be exactly:
#   https://your-domain.com/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=


# --- AI scoring --------------------------------------------------------------

# provider: anthropic | openai | gemini | demo
# With no key configured the app falls back to the built-in deterministic scorer
# and labels every result as simulated — it degrades, it does not break.
AI_PROVIDER=anthropic
AI_API_KEY=TODO-your-provider-key
AI_MODEL=claude-opus-5

# Used automatically if the primary provider fails after its retries.
AI_FALLBACK_PROVIDER=

# Speech-to-text for speaking tasks. `openai` uses Whisper; `demo` is heuristic.
AI_TRANSCRIPTION_PROVIDER=openai
AI_TRANSCRIPTION_API_KEY=TODO-your-transcription-key

# Hard monthly ceiling in USD across every AI feature. 0 disables the cap.
# When reached, scoring pauses and students are told their answer was saved —
# it never silently fails or runs up an unbounded bill.
AI_MONTHLY_BUDGET_USD=50
AI_MAX_RETRIES=2
AI_TIMEOUT_MS=45000


# --- Payments ----------------------------------------------------------------

# provider: stripe | manual | demo
# `manual` (bank transfer, Easypaisa, JazzCash) is always available regardless.
PAYMENT_PROVIDER=manual
PAYMENT_API_KEY=
PAYMENT_CURRENCY=PKR
PAYMENT_TAX_PERCENT=0

# Verifies the signature on incoming webhooks. For Stripe this is the signing
# secret from the Stripe dashboard, NOT the value below — replace it.
# An unverified webhook is an anonymous internet request and is rejected.
PAYMENT_WEBHOOK_SECRET=n-n6dKJO7aILlPWfMRv_gwtIjYoEqIGuy3UEOe6A9K8

# Shown to students on the manual-payment page. These are public by design.
BANK_NAME=TODO-your-bank
BANK_ACCOUNT_TITLE=Globify Consultants
BANK_ACCOUNT_NUMBER=TODO
BANK_IBAN=TODO
EASYPAISA_NUMBER=TODO
JAZZCASH_NUMBER=TODO


# --- Object storage ----------------------------------------------------------

# Speaking recordings and payment receipts.
# driver: s3 | local
#
# `local` writes to disk and is only viable where that disk persists and is
# backed up. On a managed/containerised host the filesystem is replaced on every
# deploy, so `s3` is required or students lose every recording.
STORAGE_DRIVER=s3
STORAGE_BUCKET=TODO-bucket-name
STORAGE_REGION=auto
# Cloudflare R2:  https://<account-id>.r2.cloudflarestorage.com
# Backblaze B2:   https://s3.<region>.backblazeb2.com
# AWS S3:         leave blank
STORAGE_ENDPOINT=TODO-endpoint
STORAGE_ACCESS_KEY=TODO
STORAGE_SECRET_KEY=TODO
STORAGE_MAX_UPLOAD_MB=15

# IMPORTANT: keep the bucket PRIVATE. The app serves every object through a
# short-lived signed URL. A public bucket would make one student's recordings
# readable by anyone who guesses a key.


# --- Email -------------------------------------------------------------------

# provider: resend | console
# `console` only logs the message — password reset links will never arrive.
# Set this properly before launch or users cannot recover their accounts.
EMAIL_PROVIDER=resend
EMAIL_API_KEY=TODO-your-resend-key
EMAIL_FROM=Globify PTE Premium <no-reply@TODO-your-domain.com>


# --- Analytics (optional) ----------------------------------------------------

NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_META_PIXEL_ID=


# --- Feature switches --------------------------------------------------------

REGISTRATION_ENABLED=true
MAINTENANCE_MODE=false


# --- Seeding (first deploy only) ---------------------------------------------
#
# Read by `npm run db:seed`. Set a real password, run the seed once, then REMOVE
# these two variables so the credentials are not sitting in your host's config.
SEED_ADMIN_EMAIL=admin@globifyconsultants.com
SEED_ADMIN_PASSWORD=TODO-a-strong-password
